<resources>
    <style name="Theme.Reedance" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorAccent">#2E70DF</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.Reedance.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#F6F9FE</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/reedance_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Reedance</item>
    </style>
</resources>
